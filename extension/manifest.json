{
  "manifest_version": 3,
  "name": "AI Chat Easy",
  "version": "0.1.0",
  "description": "Claude, ChatGPT, Gemini 입력창에서 Enter = 줄바꿈, Ctrl+Enter = 발송",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/keys.js", "content/sites.js", "content/main.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
